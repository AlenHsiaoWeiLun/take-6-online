# Game server (Railway). Leave empty in dev to use http://localhost:3001
VITE_SERVER_URL=
# Public site URL (used for share links / canonical)
VITE_SITE_URL=http://localhost:5173

# Supabase Auth (Project Settings > API). Leave empty to run guest-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AdSense. Leave empty to disable ads.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_BANNER=
VITE_ADSENSE_SLOT_RESULTS=
# Show grey placeholders where ads will go (handy in dev)
VITE_SHOW_AD_PLACEHOLDERS=true
