# --- Core ---
PORT=3001
# Comma-separated list of web origins allowed to connect (your Vercel + custom domains)
WEB_ORIGINS=http://localhost:5173
# Public URL of the web app, used for Stripe redirect URLs
WEB_URL=http://localhost:5173

# --- Supabase (Postgres via Prisma + Auth) ---
# Pooled connection (Supabase > Connect > ORMs > Prisma), port 6543
DATABASE_URL=
# Direct connection for migrations, port 5432
DIRECT_URL=
# Project URL, used to verify access tokens with the project's JWKS
SUPABASE_URL=
# Only needed for projects still on the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time price for "Take 6 Plus" (price_...)
STRIPE_PRICE_PLUS=

# --- Bots ---
# builtin = TypeScript Monte Carlo bot (default). fai = Python agent in /bots (needs python3).
BOT_ENGINE=builtin
FAI_PYTHON_BIN=python3
FAI_AGENT_ROOT=../../2026-FAI-Final-Release-main
FAI_AGENT_MODULE=src.players.TA.random_player
FAI_AGENT_CLASS=RandomPlayer
FAI_AGENT_ARGS={}
FAI_AGENT_TIMEOUT_MS=3000
