{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/server/Dockerfile",
    "watchPatterns": ["apps/server/**", "packages/shared/**", "package-lock.json"]
  },
  "deploy": {
    "preDeployCommand": ["sh -c 'if [ -n \"$DATABASE_URL\" ]; then npx prisma migrate deploy; else echo \"DATABASE_URL not set; skipping migrations\"; fi'"],
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
