{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @take6/web",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bullheads-online.vercel.app"
        }
      ],
      "destination": "https://bullheads.alenhsiao.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bullheads.vercel.app"
        }
      ],
      "destination": "https://bullheads.alenhsiao.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rules",
      "destination": "/rules/index.html"
    },
    {
      "source": "/6-nimmt-online",
      "destination": "/6-nimmt-online/index.html"
    },
    {
      "source": "/take-5-online",
      "destination": "/take-5-online/index.html"
    },
    {
      "source": "/zh-tw",
      "destination": "/zh-tw/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
